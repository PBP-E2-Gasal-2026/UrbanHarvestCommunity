PRODUCTION=False
SECRET_KEY=replace-with-a-secret-key-for-deployment
AWARD_ACTION_KEY=

# Required when PRODUCTION=True
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
SCHEMA=public

# LLM Search (model: google/gemma-3-27b-it:free)
OPENROUTER_API_KEY=

# Empty URL keeps the single local fallback worker active. Never run more than one coordinator.
LLM_RABBITMQ_URL=
LLM_WORKERS=4
LLM_MAX_ACTIVE_JOBS=3
LLM_LEASE_SECONDS=180
